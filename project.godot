# Minimal harness project for the godot-mcp self-tests. Not a game; see README.
# Keep this file minimal: a long comment header here stops Godot from
# enabling editor plugins, which silently disables the editor self-test.
config_version=5

[application]

config/name="godot-mcp-selftest"
config/features=PackedStringArray("4.3")

[editor_plugins]

enabled=PackedStringArray("res://addons/mcp_selftest/plugin.cfg")
